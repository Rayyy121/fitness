using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections.Generic;

public class HipsWaveTracker : MonoBehaviour
{
    [Header("開始畫面設定")]
    public GameObject startMenuPanel;
    public bool isGameStarted = false;

    [Header("角色控制器 (拖入掛載 SquatController 的物件)")]
    public SquatController squatController;

    [Header("UI 顯示物件")]
    public RectTransform waveBackground;   // 波形背景
    public RectTransform trackerPoint;     // 玩家紅點
    public TextMeshProUGUI scoreText;      // 右上角分數

    [Header("波形參數設定")]
    public float waveSpeed = 80f;          // 背景向左滾動速度
    public float lineWidth = 5f;           // 紅線筆觸粗細

    [Header("平滑度設定")]
    public float smoothTime = 0.08f;
    public float minSegmentDistance = 1.5f;

    [Header("標準參考軌跡公式設定 (藍線斜坡波型)")]
    public bool enableGuideWave = true;
    public Color guideLineColor = new Color(0f, 0.6f, 1f, 0.75f); 
    public float guideLineWidth = 4f;
    [Range(0.1f, 1f)]
    public float guideAmplitude = 0.6f;    // 下潛幅度佔 UI 總高度比例
    public float squatDownDuration = 2f;   // 下蹲 2 秒 (斜坡向下)
    public float holdDuration = 1f;        // 谷底停頓 1 秒 (平坡)
    public float standUpDuration = 2f;     // 起立 2 秒 (斜坡向上)

    [Header("評分公式加權 (深度60% / 頻率節奏40%)")]
    [Range(0f, 1f)] public float depthWeight = 0.6f;
    [Range(0f, 1f)] public float rhythmWeight = 0.4f;

    public bool showInstantScore = false;
    private float totalScoreSum = 0f;
    private int scoreSampleCount = 0;
    private float displayedScore = 100f;

    private float lastPlayerUIY;
    private float lastGuideUIY;

    [Header("動態淡出消失設定")]
    public float fadeOutDuration = 2f;

    private List<RectTransform> activeBackgrounds = new List<RectTransform>();
    private GameObject cleanBgPrefab; 
    private float bgWidth;

    private RectTransform lastActiveBg = null;
    private Vector2 lastDrawnPoint;
    private bool isFirstPoint = true;

    private RectTransform lastGuideActiveBg = null;
    private Vector2 lastGuideDrawnPoint;
    private bool isGuideFirstPoint = true;
    private float guideTimer = 0f;
    private float currentGuideUIY; 

    private float fixedX;
    private float startY;
    private float uiBottomY;
    private float uiMoveRange;

    private float currentUIY;
    private float yVelocity = 0f;

    private bool isFinished = false;
    private float fadeTimer = 0f;

    void Start()
    {
        if (startMenuPanel != null)
        {
            startMenuPanel.SetActive(true);
        }

        if (scoreText != null)
        {
            scoreText.gameObject.SetActive(false);
        }

        if (waveBackground != null && trackerPoint != null)
        {
            trackerPoint.anchorMin = new Vector2(0.5f, 0.5f);
            trackerPoint.anchorMax = new Vector2(0.5f, 0.5f);
            trackerPoint.pivot = new Vector2(0.5f, 0.5f);

            fixedX = trackerPoint.position.x;
            startY = trackerPoint.localPosition.y;
            currentUIY = startY;
            lastPlayerUIY = startY;
            lastGuideUIY = startY;

            // 計算 UI 底部與總活動高度
            uiBottomY = -waveBackground.rect.height / 2f;
            uiMoveRange = startY - uiBottomY;
            bgWidth = waveBackground.rect.width;

            ClearChildSegmentsImmediate(waveBackground);

            cleanBgPrefab = Instantiate(waveBackground.gameObject, waveBackground.parent);
            cleanBgPrefab.name = "Clean_WaveBackground_Template";
            ClearChildSegmentsImmediate(cleanBgPrefab.transform);
            cleanBgPrefab.SetActive(false);

            activeBackgrounds.Add(waveBackground);
            SpawnNextBackground();
        }
    }

    // 由畫面上的 START 按鈕點擊事件觸發
    public void StartGame()
    {
        if (startMenuPanel != null)
        {
            startMenuPanel.SetActive(false);
        }

        if (scoreText != null)
        {
            scoreText.gameObject.SetActive(true);
        }

        // 喚醒 SquatController 開始依時間推進讀取 CSV 數據
        if (squatController != null)
        {
            squatController.StartGamePlayback();
        }

        isGameStarted = true;
        isFirstPoint = true;
        isGuideFirstPoint = true;
        lastActiveBg = null;
        lastGuideActiveBg = null;
        guideTimer = 0f;

        totalScoreSum = 0f;
        scoreSampleCount = 0;
        displayedScore = 100f;
        lastPlayerUIY = startY;
        lastGuideUIY = startY;
        UpdateScoreUI(100f);
    }

    void Update()
    {
        if (!isGameStarted) return;
        if (trackerPoint == null || waveBackground == null) return;

        if (isFinished)
        {
            HandleFadeOut();
            return;
        }

        // ========================================================
        // 核心公式 1：玩家紅線深蹲下潛 UI 高度計算 (斜坡波形)
        // ========================================================
        float squatProgress = 0f;
        if (squatController != null)
        {
            // 讀取從 CSV 時間平滑插值出來的 0~1 正規化深蹲進度
            squatProgress = squatController.NormalizedSquatProgress;
        }

        // 目標 Y 座標 = 起始頂部 Y - (深蹲進度 * 最大下潛幅度 * UI可動範圍)
        float targetUIY = startY - (squatProgress * guideAmplitude * uiMoveRange);
        currentUIY = Mathf.SmoothDamp(currentUIY, targetUIY, ref yVelocity, smoothTime);

        trackerPoint.position = new Vector3(fixedX, trackerPoint.position.y, trackerPoint.position.z);
        trackerPoint.localPosition = new Vector3(trackerPoint.localPosition.x, currentUIY, trackerPoint.localPosition.z);

        // ========================================================
        // 背景無限循環推移
        // ========================================================
        Vector2 moveStep = Vector2.left * waveSpeed * Time.deltaTime;
        for (int i = 0; i < activeBackgrounds.Count; i++)
        {
            if (activeBackgrounds[i] != null)
            {
                activeBackgrounds[i].anchoredPosition += moveStep;
            }
        }

        RectTransform lastBg = activeBackgrounds[activeBackgrounds.Count - 1];
        float lastBgRightEdge = lastBg.anchoredPosition.x + (bgWidth * (1f - lastBg.pivot.x));

        if (lastBgRightEdge <= bgWidth * 1.5f)
        {
            SpawnNextBackground();
        }

        if (activeBackgrounds.Count > 0)
        {
            RectTransform firstBg = activeBackgrounds[0];
            float firstBgRightEdge = firstBg.anchoredPosition.x + (bgWidth * (1f - firstBg.pivot.x));
            
            if (firstBgRightEdge < -bgWidth * 1.5f)
            {
                if (lastActiveBg == firstBg) lastActiveBg = null;
                if (lastGuideActiveBg == firstBg) lastGuideActiveBg = null;

                activeBackgrounds.RemoveAt(0);
                Destroy(firstBg.gameObject);
            }
        }

        // 繪製標準藍線斜坡波形
        if (enableGuideWave)
        {
            DrawGuideWave();
        }

        // 繪製玩家即時紅線斜坡波形
        DrawPlayerWave();

        // 依據公式計算 60%/40% 綜合評分
        CalculateAndDisplayScore();
    }

    // ========================================================
    // 核心公式 2：標準參考藍線週期性斜坡公式 (SmoothStep 梯形波)
    // ========================================================
    void DrawGuideWave()
    {
        guideTimer += Time.deltaTime;
        float totalCycle = squatDownDuration + holdDuration + standUpDuration; // 預設 2s + 1s + 2s = 5s
        float cycleTime = guideTimer % totalCycle;

        float progress = 0f;

        if (cycleTime < squatDownDuration)
        {
            // 階段一：下蹲斜坡 (0s ~ 2s)，以 SmoothStep 產生平滑加速度曲線
            float t = cycleTime / squatDownDuration;
            progress = Mathf.SmoothStep(0f, 1f, t);
        }
        else if (cycleTime < squatDownDuration + holdDuration)
        {
            // 階段二：谷底停頓 (2s ~ 3s)，完全蹲到底部保持水平
            progress = 1f;
        }
        else
        {
            // 階段三：起立斜坡 (3s ~ 5s)，平滑回升至頂部站姿
            float t = (cycleTime - squatDownDuration - holdDuration) / standUpDuration;
            progress = Mathf.SmoothStep(1f, 0f, t);
        }

        // 計算標準藍線在 UI 上的絕對高度
        currentGuideUIY = startY - (progress * guideAmplitude * uiMoveRange);

        Vector3 guideLocalPos = new Vector3(trackerPoint.localPosition.x, currentGuideUIY, 0f);
        Vector3 guideWorldPos = trackerPoint.parent.TransformPoint(guideLocalPos);

        RectTransform currentTargetBg = GetBackgroundUnderPoint(guideWorldPos);
        if (currentTargetBg != null)
        {
            Vector2 localGuidePoint = currentTargetBg.InverseTransformPoint(guideWorldPos);

            if (currentTargetBg != lastGuideActiveBg)
            {
                lastGuideActiveBg = currentTargetBg;
                isGuideFirstPoint = true;
            }

            if (isGuideFirstPoint)
            {
                lastGuideDrawnPoint = localGuidePoint;
                isGuideFirstPoint = false;
            }
            else
            {
                if (Vector2.Distance(lastGuideDrawnPoint, localGuidePoint) >= minSegmentDistance)
                {
                    CreateDrawingSegment(currentTargetBg, lastGuideDrawnPoint, localGuidePoint, guideLineColor, guideLineWidth);
                    lastGuideDrawnPoint = localGuidePoint;
                }
            }
        }
        else
        {
            isGuideFirstPoint = true;
            lastGuideActiveBg = null;
        }
    }

    // ========================================================
    // 核心公式 3 & 4：綜合評分公式 (深度加權 60% + 速度加權 40%)
    // ========================================================
    void CalculateAndDisplayScore()
    {
        if (!enableGuideWave || scoreText == null || Time.deltaTime <= 0.0001f) return;

        // --- 公式 3：下蹲深度誤差精準度 (加權 60%) ---
        float errorDistance = Mathf.Abs(currentUIY - currentGuideUIY);
        float maxAllowedError = Mathf.Max(uiMoveRange * guideAmplitude, 30f);
        // 指數曲線懲罰：誤差越小分數越高
        float depthAccuracy = Mathf.Pow(1f - Mathf.Clamp01(errorDistance / maxAllowedError), 1.2f);

        // --- 公式 4：節奏速度差精準度 (加權 40%) ---
        float playerVelocity = (currentUIY - lastPlayerUIY) / Time.deltaTime;
        float guideVelocity = (currentGuideUIY - lastGuideUIY) / Time.deltaTime;

        float maxExpectedVelocity = (uiMoveRange * guideAmplitude) / squatDownDuration;
        float velocityError = Mathf.Abs(playerVelocity - guideVelocity);
        float rhythmAccuracy = 1f - Mathf.Clamp01(velocityError / (maxExpectedVelocity * 2.5f));

        lastPlayerUIY = currentUIY;
        lastGuideUIY = currentGuideUIY;

        // 綜合加權總分 (1 ~ 100 分)
        float combinedAccuracy = (depthAccuracy * depthWeight) + (rhythmAccuracy * rhythmWeight);
        float instantScore = Mathf.Lerp(1f, 100f, Mathf.Clamp01(combinedAccuracy));

        if (showInstantScore)
        {
            displayedScore = Mathf.Lerp(displayedScore, instantScore, Time.deltaTime * 5f);
        }
        else
        {
            totalScoreSum += instantScore;
            scoreSampleCount++;
            float averageScore = totalScoreSum / scoreSampleCount;
            displayedScore = Mathf.Lerp(displayedScore, averageScore, Time.deltaTime * 8f);
        }

        UpdateScoreUI(displayedScore);
    }

    void UpdateScoreUI(float score)
    {
        if (scoreText == null) return;

        int finalScoreInt = Mathf.Clamp(Mathf.RoundToInt(score), 1, 100);
        scoreText.text = $"Score: {finalScoreInt}";

        if (finalScoreInt >= 85)
            scoreText.color = new Color(0.2f, 1f, 0.2f);
        else if (finalScoreInt >= 60)
            scoreText.color = new Color(1f, 0.85f, 0.1f);
        else
            scoreText.color = new Color(1f, 0.3f, 0.3f);
    }

    void DrawPlayerWave()
    {
        RectTransform currentTargetBg = GetBackgroundUnderPoint(trackerPoint.position);
        if (currentTargetBg != null)
        {
            Vector2 localPoint = currentTargetBg.InverseTransformPoint(trackerPoint.position);

            if (currentTargetBg != lastActiveBg)
            {
                lastActiveBg = currentTargetBg;
                isFirstPoint = true;
            }

            if (isFirstPoint)
            {
                lastDrawnPoint = localPoint;
                isFirstPoint = false;
            }
            else
            {
                if (Vector2.Distance(lastDrawnPoint, localPoint) >= minSegmentDistance)
                {
                    CreateDrawingSegment(currentTargetBg, lastDrawnPoint, localPoint, Color.red, lineWidth);
                    lastDrawnPoint = localPoint;
                }
            }
        }
        else
        {
            isFirstPoint = true;
            lastActiveBg = null;
        }
    }

    void SpawnNextBackground()
    {
        RectTransform previousBg = activeBackgrounds[activeBackgrounds.Count - 1];

        GameObject newBgObj = Instantiate(cleanBgPrefab, waveBackground.parent);
        newBgObj.name = "WaveBackground_Seamless";
        newBgObj.SetActive(true);

        RectTransform newRect = newBgObj.GetComponent<RectTransform>();

        newRect.anchorMin = previousBg.anchorMin;
        newRect.anchorMax = previousBg.anchorMax;
        newRect.pivot = previousBg.pivot;
        newRect.sizeDelta = previousBg.sizeDelta;
        newRect.anchoredPosition = new Vector2(previousBg.anchoredPosition.x + bgWidth, previousBg.anchoredPosition.y);

        newBgObj.transform.SetSiblingIndex(trackerPoint.GetSiblingIndex());

        activeBackgrounds.Add(newRect);
    }

    RectTransform GetBackgroundUnderPoint(Vector3 worldPoint)
    {
        for (int i = 0; i < activeBackgrounds.Count; i++)
        {
            RectTransform bg = activeBackgrounds[i];
            if (bg == null) continue;

            Vector3 localPos = bg.InverseTransformPoint(worldPoint);
            if (bg.rect.Contains(localPos))
            {
                return bg;
            }
        }

        return activeBackgrounds.Count > 0 ? activeBackgrounds[0] : null;
    }

    void CreateDrawingSegment(RectTransform parentBg, Vector2 start, Vector2 end, Color color, float width)
    {
        GameObject segment = new GameObject("UI_Smooth_Line_Segment", typeof(Image));
        segment.transform.SetParent(parentBg, false);
        segment.transform.SetAsLastSibling();

        Image img = segment.GetComponent<Image>();
        img.color = color;

        RectTransform rect = segment.GetComponent<RectTransform>();
        rect.anchorMin = new Vector2(0.5f, 0.5f);
        rect.anchorMax = new Vector2(0.5f, 0.5f);
        rect.pivot = new Vector2(0f, 0.5f);

        Vector2 dir = end - start;
        float distance = dir.magnitude;
        float angle = Mathf.Atan2(dir.y, dir.x) * Mathf.Rad2Deg;

        rect.anchoredPosition = start;
        rect.sizeDelta = new Vector2(distance, width);
        rect.localRotation = Quaternion.Euler(0, 0, angle);
    }

    void ClearChildSegmentsImmediate(Transform parent)
    {
        for (int i = parent.childCount - 1; i >= 0; i--)
        {
            Transform child = parent.GetChild(i);
            if (child != trackerPoint)
            {
                DestroyImmediate(child.gameObject);
            }
        }
    }

    public void FinishAndFadeOut()
    {
        isFinished = true;
        fadeTimer = 0f;
    }

    private void HandleFadeOut()
    {
        fadeTimer += Time.deltaTime;
        float alpha = Mathf.Lerp(1f, 0f, fadeTimer / fadeOutDuration);

        foreach (var bg in activeBackgrounds)
        {
            if (bg != null)
            {
                CanvasGroup cg = bg.GetComponent<CanvasGroup>();
                if (cg == null) cg = bg.gameObject.AddComponent<CanvasGroup>();
                cg.alpha = alpha;
            }
        }

        if (alpha <= 0.01f)
        {
            foreach (var bg in activeBackgrounds)
            {
                if (bg != null) bg.gameObject.SetActive(false);
            }
            if (cleanBgPrefab != null) Destroy(cleanBgPrefab);

            if (scoreText != null)
            {
                scoreText.gameObject.SetActive(false);
            }

            gameObject.SetActive(false);
        }
    }
}
